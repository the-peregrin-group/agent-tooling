#!/usr/bin/env python3
"""triage-inventory — board-anchored inventory read (autonomous, read-only).

Emits the full triage inventory as JSON on stdout:

  {
    "items":       [ <normalized issue record>, ... ],   # one per board item that is an Issue
    "not_on_board":[ {"number":N,"title":...}, ... ],     # open issues absent from the board
    "summary":     { counts by status / state, totals }
  }

The ProjectV2 board is the inventory anchor (not the repo issue list): it carries
Status, yields the PVTI_ item id every field mutation needs, and surfaces closed
issues still in a non-terminal status (R-SYNC-2). A second cheap query reconciles
the board against the open-issue list to catch issues not yet on the board.

Read-only: this wrapper performs no mutations.
"""

from __future__ import annotations

import argparse
import json
import sys

sys.path.insert(0, __import__("os").path.dirname(__file__))
import lib_profile  # noqa: E402
import lib_gh  # noqa: E402

_QUERY = """
query($project:ID!, $endCursor:String) {
  node(id:$project) {
    ... on ProjectV2 {
      items(first:50, after:$endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          status:      fieldValueByName(name:"Status")       { ... on ProjectV2ItemFieldSingleSelectValue { name optionId } }
          priority:    fieldValueByName(name:"Priority")     { ... on ProjectV2ItemFieldSingleSelectValue { name optionId } }
          size:        fieldValueByName(name:"Size")         { ... on ProjectV2ItemFieldSingleSelectValue { name optionId } }
          lastTriaged: fieldValueByName(name:"Last Triaged") { ... on ProjectV2ItemFieldDateValue { date } }
          content {
            __typename
            ... on Issue {
              number databaseId title state stateReason url lastEditedAt
              editor { login }
              labels(first:30)    { nodes { name } }
              assignees(first:10) { nodes { login } }
              parent { number }
              subIssues(first:1)  { totalCount }
            }
          }
        }
      }
    }
  }
}
"""


def _sv(v):
    """Single-select value -> {'name','optionId'} or None."""
    if not v:
        return None
    return {"name": v.get("name"), "optionId": v.get("optionId")}


def _normalize(node: dict) -> dict | None:
    content = node.get("content") or {}
    if content.get("__typename") != "Issue":
        return None  # draft cards, PRs
    return {
        "itemId": node["id"],
        "number": content["number"],
        "databaseId": content["databaseId"],
        "title": content["title"],
        "issueState": content["state"],            # OPEN / CLOSED
        "stateReason": content.get("stateReason"),  # COMPLETED / NOT_PLANNED / REOPENED / null
        "url": content["url"],
        "lastEditedAt": content.get("lastEditedAt"),
        "editor": (content.get("editor") or {}).get("login"),
        "labels": [n["name"] for n in (content.get("labels") or {}).get("nodes", [])],
        "assignees": [n["login"] for n in (content.get("assignees") or {}).get("nodes", [])],
        "parent": (content.get("parent") or {}).get("number"),
        "subIssueCount": (content.get("subIssues") or {}).get("totalCount", 0),
        "status": _sv(node.get("status")),
        "priority": _sv(node.get("priority")),
        "size": _sv(node.get("size")),
        "lastTriaged": (node.get("lastTriaged") or {}).get("date"),
    }


def main():
    ap = argparse.ArgumentParser(description="Read the triage inventory (read-only).")
    lib_profile.add_common_args(ap)
    args = ap.parse_args()
    prof = lib_profile.load_or_die(args)

    items: list[dict] = []
    cursor = None
    while True:
        data = lib_gh.graphql(_QUERY, {"project": prof.project_node_id, "endCursor": cursor})
        conn = data["node"]["items"]
        for node in conn["nodes"]:
            rec = _normalize(node)
            if rec is not None:
                items.append(rec)
        if conn["pageInfo"]["hasNextPage"]:
            cursor = conn["pageInfo"]["endCursor"]
        else:
            break

    on_board = {it["number"] for it in items}
    open_issues = lib_gh.issue_list_open(prof.repo)
    not_on_board = [oi for oi in open_issues if oi["number"] not in on_board]

    by_status: dict[str, int] = {}
    by_state: dict[str, int] = {}
    for it in items:
        s = (it["status"] or {}).get("name") or "(unset)"
        by_status[s] = by_status.get(s, 0) + 1
        by_state[it["issueState"]] = by_state.get(it["issueState"], 0) + 1

    json.dump(
        {
            "profile": prof.repo,
            "items": items,
            "not_on_board": not_on_board,
            "summary": {
                "board_items": len(items),
                "open_issues": len(open_issues),
                "not_on_board": len(not_on_board),
                "by_status": by_status,
                "by_issue_state": by_state,
            },
        },
        sys.stdout,
        indent=2,
    )
    sys.stdout.write("\n")


if __name__ == "__main__":
    try:
        main()
    except (lib_profile.ProfileError, lib_gh.GhError) as e:
        lib_gh.die(f"triage-inventory: {e}", 1)
