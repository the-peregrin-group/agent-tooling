# Python bytecode caches (rebuild themselves)
__pycache__/
*.pyc

.DS_Store

# Machine-local wiring generated by the knowledge base's init-project-repo; never committed
.claude/settings.local.json

# Beads keeps its workspace gate lock beside .beads/, not inside it (bd 1.3.0)
/.beads.gate.lock*

# The harness creates agent worktrees inside the checkout when an agent enters one
/.claude/worktrees/

# Subagents with project-scoped memory (code-reviewer) write their notes here
/.claude/agent-memory/
