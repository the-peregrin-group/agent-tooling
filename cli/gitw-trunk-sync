#!/usr/bin/python3
"""gitw-trunk-sync <repo> -- fast-forward the local default branch, never switching any worktree.

Verifies the working copy at cwd against the roster entry for <repo>
(~/.config/gitw/repos.toml), fetches the authoritative remote, then
fast-forwards the local default branch to the fetched tip. Typical use:
after a forge merge or a gitw-integrate, so the human's primary checkout
is current. Agents never depend on it (gitw-branch-start branches from the
remote-tracking ref); it is a convenience.

No worktree is ever switched. Where the local default branch is checked
out decides how it moves:
  - in the primary checkout, worktree clean: `git merge --ff-only` run
    inside the primary checkout;
  - nowhere: `git update-ref`, guarded by the branch's old value;
  - in the primary checkout with a dirty worktree (or a merge,
    cherry-pick, or revert in progress): refused, the dirt is the human's;
  - a rebase of the default branch in progress in any worktree (HEAD is
    detached there, so the branch looks checked out nowhere): refused;
  - in a linked worktree: refused, another agent may be live on it.
A local default branch that has commits the fetched tip lacks (diverged,
or merely ahead) is refused: unpushed local trunk commits are the human's
parked work. The branch is never moved backwards, and nothing is created
or deleted. Already at the fetched tip, and machine-local entries (no
remote, nothing to fetch), are converged no-ops. Runs only from inside a
worktree of the labeled repo.

Output is the usual JSON plan with "action": "applied" and a "result" of
"fast-forwarded", "ref-moved", "up-to-date", or "machine-local".

Exit codes: 0 success, including a converged no-op, 1 unclassified git
failure, 2 usage error, 3 not found (label not in the roster, vanished
remote repository, or the local or fetched default branch missing),
4 refused (identity mismatch, dirty primary checkout, default branch
checked out in a linked worktree, rebase of it in progress, local default
branch not an ancestor of the fetched tip, or the branch moved concurrently
during the update), 5 roster missing/malformed or auth failure, 6 network
failure.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import plan
from lib.git import repo, roster, run

_USAGE = "gitw-trunk-sync <repo>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 1:
        plan.usage_die("expected exactly one argument, the repo label", _USAGE)
    entry = roster.resolve_or_die(argv[0], _USAGE)

    try:
        workspace = repo.resolve_workspace(entry, Path.cwd())
        if not workspace.in_repo:
            raise repo.RefusalError(
                "gitw-trunk-sync runs from inside a worktree of "
                f"{entry.label!r} ({entry.checkout}), not from an "
                "operable_from path"
            )
        repo.verify_remote(workspace)
        payload = _sync(workspace)
    except repo.RefusalError as error:
        run.die(str(error), plan.EXIT_REFUSED)
    except run.GitError as error:
        run.die(str(error), error.exit_code)

    plan.emit_plan("applied", **payload)
    return plan.EXIT_OK


def _sync(workspace: repo.Workspace) -> dict:
    entry = workspace.entry
    root = workspace.root
    branch = entry.default_branch
    local_ref = f"refs/heads/{branch}"
    base = {"repo": entry.label, "branch": branch}
    if entry.machine_local:
        return {**base, "result": "machine-local"}

    run.fetch(entry.remote, root)
    display, tip_ref = repo.authoritative_ref(entry)
    tip = run.output(["rev-parse", "--verify", "--quiet", tip_ref], root)
    if tip is None:
        run.die(
            f"authoritative default {display} not found in {root}; the "
            "roster's default_branch may be wrong",
            plan.EXIT_NOT_FOUND,
        )
    old = run.output(["rev-parse", "--verify", "--quiet", local_ref], root)
    if old is None:
        run.die(
            f"local branch {branch!r} does not exist in {root}; "
            "gitw-trunk-sync creates nothing",
            plan.EXIT_NOT_FOUND,
        )
    moved = {**base, "from": old, "to": tip, "source": display}
    if old == tip:
        return {**moved, "result": "up-to-date"}
    ancestor = run.run(["merge-base", "--is-ancestor", old, tip], root)
    if ancestor.returncode == 1:
        raise repo.RefusalError(
            f"local {branch!r} ({old[:12]}) is not an ancestor of {display} "
            f"({tip[:12]}): it has commits the remote lacks, which are the "
            "human's to reconcile"
        )
    if ancestor.returncode != 0:
        detail = ancestor.stderr.strip() or "no output"
        raise run.GitError(f"git merge-base --is-ancestor failed: {detail}")

    primary = entry.checkout.resolve()
    # A worktree mid-rebase of the default branch is detached, so the
    # holder lookup below cannot see it: check every worktree first.
    for tree in _worktree_paths(root):
        if repo.rebase_head_branch(tree) == branch:
            raise repo.RefusalError(
                f"a rebase of {branch!r} is in progress in {tree}; "
                "not moving the branch underneath it"
            )
    holder = repo.worktree_holding_branch(root, branch)
    if holder is None:
        # Compare-and-swap on the old value: a concurrent mover loses
        # loudly rather than being clobbered.
        result = run.run(["update-ref", local_ref, tip, old], root)
        if result.returncode != 0:
            detail = result.stderr.strip() or result.stdout.strip() or "no output"
            now = run.output(["rev-parse", "--verify", "--quiet", local_ref], root)
            if now is not None and now != old:
                raise repo.RefusalError(
                    f"{branch!r} moved while syncing ({old[:12]} -> "
                    f"{now[:12]}); not overwriting it"
                )
            raise run.GitError(f"git update-ref failed: {detail}")
        return {**moved, "result": "ref-moved"}
    if holder != primary:
        raise repo.RefusalError(
            f"{branch!r} is checked out in a linked worktree ({holder}) -- "
            "another agent may be live on it; not touching it"
        )
    dirty = repo.status_counts(primary)
    if any(dirty.values()):
        raise repo.RefusalError(
            f"the primary checkout {primary} holds {branch!r} and is dirty "
            f"({repo.describe_dirty(dirty)}); the dirt is the human's, so "
            "not fast-forwarding"
        )
    operation = repo.pending_operation(primary)
    if operation is not None:
        raise repo.RefusalError(
            f"the primary checkout {primary} has a {operation} in progress; "
            "not fast-forwarding"
        )
    # Merge by sha, not by ref name: the fetched tip this decision used.
    result = run.run(["merge", "--ff-only", tip], primary)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise run.GitError(f"git merge --ff-only failed: {detail}")
    return {**moved, "result": "fast-forwarded"}


def _worktree_paths(root: Path) -> list:
    """Every worktree of the repo, from any worktree of it."""
    raw = run.must(["worktree", "list", "--porcelain"], root)
    return [
        Path(line[len("worktree ") :])
        for line in raw.splitlines()
        if line.startswith("worktree ")
    ]


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
