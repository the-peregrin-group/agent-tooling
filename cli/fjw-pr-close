#!/usr/bin/python3
"""fjw-pr-close <owner/repo> <pr#> <comment-file> -- close a pull request with an attached comment.

The comment is mandatory by design: a silent unattended close must not be
expressible (the consumer's close always links its successor PR). No atomic
close-with-comment exists in the API, so the comment posts first, then the
PR is PATCHed closed. The Verb is idempotent: before posting, it reads the
PR's timeline and skips the post when the machine account already left a
comment matching the staged one (compared after normalizing line endings,
whitespace, and case), counting only comments after the PR's most recent
reopen. So a close that fails after the comment landed is finished by
re-running with the same comment file, which closes without posting again.
Recognizing its own comment takes the machine account's login, the
deployment config's `login` key; without it the Verb exits 1 before acting.
Closing an already-closed PR is a converged no-op: exit 0, nothing posted
(the comment implies an act this run did not perform). Merge is not here
and never will be: it is a human-only act, absent from the fjw surface
entirely. Acts as the deployment's machine account.

Exit codes (the Exit-code contract): 0 closed (including the already-closed
no-op), 1 broken on our side (credentials, config including a missing
`login`, the network, a server error; nothing was closed), 2 the call must
change (usage, comment file), 3 no such PR (or no such repository), 4 the
machine account's grant is too weak for the action, 5 partial completion:
the comment is on the PR but the close failed; fix the cause the message
names, then re-run with the same comment file.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.forgejo import api, config as fjw_config, pulls

_USAGE = "fjw-pr-close <owner/repo> <pr#> <comment-file>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 3:
        plan.usage_die("expected exactly three arguments", _USAGE)
    repository, raw_index, comment_path = argv
    if not pulls.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    index = arguments.parse_issue_number(raw_index)
    if index is None:
        plan.usage_die(f"pr# must be a positive integer, got {raw_index!r}", _USAGE)
    comment = staging.read_staged_body(comment_path, description="comment file")

    try:
        configuration = fjw_config.load()
    except fjw_config.ConfigError as error:
        api.die(str(error), plan.EXIT_BROKEN)
    login = configuration.login
    if login is None:
        api.die(
            "the fjw deployment config has no 'login' key; fjw-pr-close "
            "needs the machine account's login to recognize its own "
            "comment on a re-run. Report it to the user: the deployment "
            "must add it. Nothing was posted or closed",
            plan.EXIT_BROKEN,
        )

    try:
        pr = pulls.get_pr(configuration, repository, index)
    except api.ApiError as error:
        api.die(str(error), error.exit_code)
    if pr.get("state") == "closed":
        print(
            f"note: PR #{index} on {repository} is already closed; "
            "not posting the comment",
            file=sys.stderr,
        )
        plan.emit_plan(
            "applied", repository=repository, pr=index, closed=True, noop=True
        )
        return plan.EXIT_OK

    try:
        existing = pulls.find_own_comment(
            pulls.list_timeline(configuration, repository, index),
            login,
            comment,
        )
    except api.ApiError as error:
        api.die(
            f"could not read the PR's timeline; nothing posted, PR left "
            f"open: {error}",
            error.exit_code,
        )
    if existing is not None:
        comment_id = existing.get("id")
        print(
            f"note: comment {comment_id} on PR #{index} already matches the "
            "comment file; not posting it again",
            file=sys.stderr,
        )
    else:
        try:
            posted = pulls.create_comment(
                configuration, repository, index, comment
            )
        except api.ApiError as error:
            api.die(
                f"comment failed, PR left open: {error}. Re-running "
                "fjw-pr-close with the same comment file will not post "
                "the comment twice",
                error.exit_code,
            )
        comment_id = posted.get("id")
        author = (posted.get("user") or {}).get("login")
        if author and author.casefold() != login.casefold():
            print(
                f"warning: the comment was posted as {author!r}, but the "
                f"deployment config's login is {login!r}; a re-run will not "
                "recognize it. Report the mismatch to the user",
                file=sys.stderr,
            )

    try:
        closed = pulls.close_pr(configuration, repository, index)
    except api.ApiError as error:
        api.die(
            f"PARTIAL: comment {comment_id} is on PR #{index} but the close "
            f"failed: {error}. Once the cause clears, re-run fjw-pr-close "
            "with the same comment file to finish the close; it will not "
            "post the comment again",
            plan.EXIT_PARTIAL_COMPLETION,
        )

    plan.emit_plan(
        "applied",
        repository=repository,
        pr=index,
        closed=closed.get("state") == "closed",
        comment=comment_id,
        comment_posted=existing is None,
        url=closed.get("html_url"),
    )
    return plan.EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
