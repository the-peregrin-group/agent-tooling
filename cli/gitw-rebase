#!/usr/bin/python3
"""gitw-rebase <repo> <branch-prefix> [continue|abort | onto <base-branch>] -- rebase the own branch onto a fresh base.

Bare form: verify the working copy at cwd against the roster entry for
<repo> (~/.config/gitw/repos.toml) and the pinned branch prefix, fetch
the authoritative remote, then rebase the current branch onto the fetched
authoritative default. Clean completion exits 0. A conflict leaves the
standard git conflict state in place -- it IS the work product -- and
exits 4 with a JSON listing of the conflicted paths.

`onto <base-branch>`: the same, but onto the fetched
<remote>/<base-branch> -- the rebase half of the loop into an agent
integration branch a repo designates. It mirrors gitw-integrate's
<base-branch>: Permission rules pin the base (an exact rule per base; a
rule starred after the prefix admits any base), and the roster is not
asked which bases are legitimate. The base must exist on the remote
after the fetch (exit 3 otherwise). Refused (exit 4): the roster's
default branch, HEAD (or any base whose first level is HEAD), a
symbolic remote-tracking ref aliasing the default -- the bare form is
the one spelling for the default, so a consumer granting exact rules
grants the default and each agent integration branch separately -- and the
branch itself as its own base. Machine-local repos refuse the onto form:
there is no fetched base to rebase onto.

The reported `onto`: at a conflict stop the base's display name and the
commit it named are recorded in a gitw-onto file inside git's own rebase
state directory, which git deletes when the rebase completes or aborts,
so the record cannot outlive its rebase. Later stops and the final
`continue` report the recorded name only while the recorded commit
equals git's own onto commit; with no record, or a disagreeing one (a
rebase gitw did not start), they report `"onto": null` and write no
record, so a guessed name never sticks to someone else's rebase.

Conflicted paths: every stop also appends its conflicted paths to a
gitw-conflicts record (NUL-separated) in the same state directory, so
it dies with the rebase and survives a context compaction between
stops. The stop payload's `conflicts` stays that stop's own files; the
final successful `continue` adds `resolved`, the sorted, de-duplicated
union of every stop's files (and the files it just resolved). A rebase
gitw did not start has no record and reports only the files that
`continue` itself saw.

`continue`: stage the resolutions (exactly the conflicted paths, nothing
else) and proceed; the cycle repeats per conflict (each stop exits 4
with the fresh conflict listing). Files still carrying a full conflict
marker triple (<<<<<<< / ======= / >>>>>>>) are refused before anything
is staged, as is a resolution set touching a local-only file
(settings.local.json, .env*). `abort`: restore the pre-rebase branch.
Both modes require an in-progress rebase and verify its branch (from
the rebase state's head-name -- HEAD is detached mid-rebase) against
the pinned prefix.
A bare '/' prefix matches any branch except the authoritative default.
There is deliberately no `skip`: silently dropping a commit is a
human-decision moment.

A dirty worktree refuses the bare form (commit or discard explicitly).
Whether a session may rebase or resolve conflicts unattended is
skill-side; this wrapper enforces only what is machine-checkable.

Exit codes: 0 success, 1 unclassified git failure, 2 usage error, 3 not
found (label not in the roster, the authoritative default missing, or
the onto base missing on the remote), 4 refused (cwd/branch-prefix
mismatch, dirty worktree, rebase already or not in progress, conflict
stop, unresolved markers on continue, an onto base that is the default,
HEAD, an alias of the default, or the branch itself, onto on a
machine-local repo), 5 roster/auth/config (deployment), 6
network failure.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import plan
from lib.git import arguments, policy, repo, roster, run

_USAGE = (
    "gitw-rebase <repo> <branch-prefix> [continue|abort | onto <base-branch>]"
)

# The base a stopped rebase was started onto, kept inside git's own rebase
# state directory so that its lifetime is exactly the rebase's.
_ONTO_RECORD = "gitw-onto"
_CONFLICTS_RECORD = "gitw-conflicts"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) not in (2, 3, 4):
        plan.usage_die(
            "expected repo label and branch prefix, optionally followed by "
            "'continue', 'abort', or 'onto <base-branch>'",
            _USAGE,
        )
    mode = None
    base = None
    if len(argv) >= 3:
        if argv[2] == "onto":
            if len(argv) != 4:
                plan.usage_die("'onto' takes exactly one base branch", _USAGE)
            base = argv[3]
            if not arguments.is_valid_branch(base):
                plan.usage_die(
                    f"base branch must be a plain branch name, got {base!r}",
                    _USAGE,
                )
        elif argv[2] not in ("continue", "abort"):
            plan.usage_die(
                f"the only positional modes are 'continue', 'abort', and "
                f"'onto <base-branch>' (there is deliberately no 'skip'), "
                f"got {argv[2]!r}",
                _USAGE,
            )
        elif len(argv) == 4:
            plan.usage_die(f"{argv[2]!r} takes no further arguments", _USAGE)
        else:
            mode = argv[2]
    label, prefix = argv[:2]
    if not arguments.is_valid_branch_prefix(prefix):
        plan.usage_die(
            f"branch prefix must be lowercase, single-level, and end in "
            f"'/' (e.g. 'fix/'), or be a bare '/' for no branch "
            f"constraint, got {prefix!r}",
            _USAGE,
        )
    entry = roster.resolve_or_die(label, _USAGE)

    try:
        workspace = repo.resolve_workspace(entry, Path.cwd())
        if not workspace.in_repo:
            raise repo.RefusalError(
                "gitw-rebase rewrites the worktree at cwd; run it from "
                f"inside a worktree of {label!r} ({entry.checkout}), not "
                "from an operable_from path"
            )
        repo.verify_remote(workspace)
        if mode == "continue":
            payload = _continue(workspace, prefix)
        elif mode == "abort":
            payload = _abort(workspace, prefix)
        else:
            payload = _rebase(workspace, prefix, base)
    except repo.RefusalError as error:
        run.die(str(error), plan.EXIT_REFUSED)
    except run.GitError as error:
        run.die(str(error), error.exit_code)

    plan.emit_plan("applied", **payload)
    return plan.EXIT_OK


def _conflict_stop(
    workspace: repo.Workspace,
    branch: str,
    onto: tuple[str, str] | None,
    prefix: str,
) -> None:
    """A rebase stop is not a wrapper failure: emit the conflict listing
    as JSON (the machine-readable work order) and exit 4, leaving the
    standard git conflict state in place. `onto` is the (display name,
    commit) the rebase was started onto, or None when unknown -- then
    nothing is recorded and the JSON reports `"onto": null`."""
    label = workspace.entry.label
    if onto is not None:
        _record_onto(workspace.root, *onto)
    conflicts = repo.conflicted_paths(workspace.root)
    _record_conflicts(workspace.root, conflicts)
    plan.emit_plan(
        "conflict",
        repo=label,
        branch=branch,
        onto=onto[0] if onto is not None else None,
        conflicts=conflicts,
        worktree=str(workspace.root),
        hint=(
            f"resolve the conflicts, then `gitw-rebase {label} {prefix} "
            f"continue`; or `gitw-rebase {label} {prefix} abort`"
        ),
    )
    sys.exit(plan.EXIT_REFUSED)


def _recorded_conflicts(root: Path) -> list:
    """Every path recorded at the in-progress rebase's earlier stops
    (NUL-separated, so odd file names survive); empty with no record."""
    state_dir = repo.rebase_state_dir(root)
    if state_dir is None:
        return []
    try:
        raw = (state_dir / _CONFLICTS_RECORD).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return []
    return [path for path in raw.split("\0") if path]


def _record_conflicts(root: Path, paths: list) -> list:
    """Union `paths` into the stop record kept in the rebase state
    directory (which git deletes on completion or abort, so no stale
    record can outlive its rebase) and return the sorted, de-duplicated
    union. Best effort: a lost write only costs the later `resolved`
    list the earlier stops' files."""
    union = sorted(set(_recorded_conflicts(root)) | set(paths))
    state_dir = repo.rebase_state_dir(root)
    if state_dir is not None and union:
        try:
            (state_dir / _CONFLICTS_RECORD).write_text(
                "\0".join(union) + "\0", encoding="utf-8"
            )
        except OSError:
            pass
    return union


def _git_onto(state_dir: Path) -> str | None:
    """The commit git itself records as the rebase's onto target."""
    try:
        return (state_dir / "onto").read_text(encoding="utf-8").strip() or None
    except OSError:
        return None


def _record_onto(root: Path, display: str, commit: str) -> None:
    """Keep the base's display name, and the commit it named when the
    rebase started, in the rebase state directory for the stops a later
    `continue` reports. Best effort: a lost record only costs those
    reports their `onto` (null instead)."""
    state_dir = repo.rebase_state_dir(root)
    if state_dir is None:
        return
    try:
        (state_dir / _ONTO_RECORD).write_text(
            f"{display}\n{commit}\n", encoding="utf-8"
        )
    except OSError:
        pass


def _recorded_onto(root: Path) -> tuple[str, str] | None:
    """The (display name, commit) the in-progress rebase was started onto,
    from the record a gitw conflict stop left -- or None when there is no
    record or it disagrees with git's own onto commit. A rebase gitw did
    not start (raw git, or a record from some other rebase) therefore
    reports `"onto": null` rather than a guessed name, and gets no
    record. The recorded commit, not the base ref's current tip, is what
    is compared: a fetch mid-rebase may legitimately move the ref."""
    state_dir = repo.rebase_state_dir(root)
    if state_dir is None:
        return None
    try:
        lines = (state_dir / _ONTO_RECORD).read_text(
            encoding="utf-8"
        ).split()
    except OSError:
        return None
    if len(lines) != 2:
        return None
    display, commit = lines
    if commit != _git_onto(state_dir):
        return None
    return display, commit


def _base_ref(
    entry: roster.Entry, base: str | None, root: Path, prefix: str
) -> tuple[str, str]:
    """The (display name, full refname) to rebase onto, resolved after the
    fetch: the authoritative default for the bare form, else the fetched
    <remote>/<base>. Dies with exit 3 when the ref is missing; refuses
    (exit 4) a base that is a symbolic alias of the default."""
    if base is None:
        display, refname = repo.authoritative_ref(entry)
        if not repo.ref_exists(root, refname):
            run.die(
                f"authoritative default {display} not found in {root}; the "
                "roster's default_branch may be wrong",
                plan.EXIT_NOT_FOUND,
            )
        return display, refname
    display = f"{entry.remote}/{base}"
    refname = f"refs/remotes/{entry.remote}/{base}"
    if not repo.ref_exists(root, refname):
        run.die(
            f"base branch {base!r} not found on {entry.remote} (no "
            f"{refname} after fetching)",
            plan.EXIT_NOT_FOUND,
        )
    # A symbolic remote-tracking ref aliasing the default (origin/HEAD is
    # the usual one) is the default under another spelling. Judged by the
    # symref's target, not by commit equality: a freshly cut agent
    # integration branch legitimately sits on the default's tip.
    target = run.output(["symbolic-ref", "--quiet", refname], root)
    _, default_refname = repo.authoritative_ref(entry)
    if target is not None and target.casefold() == default_refname.casefold():
        raise repo.RefusalError(
            f"{base!r} resolves to the default branch; use the bare form, "
            f"`gitw-rebase {entry.label} {prefix}`"
        )
    return display, refname


def _rebase(
    workspace: repo.Workspace, prefix: str, base: str | None = None
) -> dict:
    entry = workspace.entry
    root = workspace.root
    if base is not None:
        if entry.machine_local:
            raise repo.RefusalError(
                f"repo {entry.label!r} is machine-local; there is no "
                "fetched base to rebase onto. Use the bare form, which "
                "rebases onto the local default"
            )
        # HEAD (origin/HEAD) is the default under another spelling.
        bare_form = f"`gitw-rebase {entry.label} {prefix}`"
        if repo.is_default_branch(base, entry.default_branch):
            raise repo.RefusalError(
                f"{base!r} is the authoritative default branch; rebase "
                f"onto it with the bare form, {bare_form}, not with 'onto'"
            )
        if base.partition("/")[0].casefold() == "head":
            raise repo.RefusalError(
                f"{base!r} names the default branch by another spelling "
                f"(HEAD); use the bare form, {bare_form}"
            )
    if repo.rebase_head_branch(root) is not None:
        raise repo.RefusalError(
            "a rebase is already in progress in this worktree; finish it "
            "with 'continue' or 'abort'"
        )
    branch = repo.require_prefixed_branch(
        root, prefix, entry.label, entry.default_branch
    )
    if base is not None and branch.casefold() == base.casefold():
        raise repo.RefusalError(
            f"branch and base are both {base!r}; rebase onto the base you "
            "will land into, not onto the branch itself"
        )
    dirty = repo.status_counts(root)
    if any(dirty.values()):
        raise repo.RefusalError(
            f"worktree {root} is dirty ({repo.describe_dirty(dirty)}); "
            "commit or discard explicitly before rebasing"
        )
    if not entry.machine_local:
        run.fetch(entry.remote, root)
    display, refname = _base_ref(entry, base, root, prefix)
    # Same TOCTOU stance as branch-start's switch: a file written during
    # the fetch must not ride through the rebase's checkouts.
    dirty = repo.status_counts(root)
    if any(dirty.values()):
        raise repo.RefusalError(
            f"worktree {root} became dirty during the fetch; commit or "
            "discard explicitly before rebasing"
        )

    base_commit = run.must(["rev-parse", "--verify", refname], root)
    result = run.run(["rebase", refname], root)
    if result.returncode != 0:
        if repo.rebase_head_branch(root) is not None:
            _conflict_stop(workspace, branch, (display, base_commit), prefix)
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise run.GitError(f"git rebase failed: {detail}")

    counts = repo.ahead_behind(root, "HEAD", refname)
    return {
        "repo": entry.label,
        "mode": "rebase",
        "branch": branch,
        "onto": display,
        "commit": repo.head_commit(root),
        "commits_atop": counts[0] if counts else None,
        "worktree": str(root),
    }


def _in_progress_branch(
    root: Path, prefix: str, label: str, default_branch: str
) -> str:
    branch = repo.rebase_head_branch(root)
    if branch is None:
        raise repo.RefusalError(
            "no rebase is in progress in this worktree; use the bare form "
            "to start one"
        )
    repo.require_branch_in_scope(
        branch, prefix, label, default_branch,
        subject="in-progress rebase branch",
    )
    return branch


def _has_marker_triple(root: Path, path: str) -> bool:
    """True when the file still carries a full conflict-marker triple --
    all three of <<<<<<< / ======= / >>>>>>> at line starts. Requiring
    the triple keeps legitimate content that merely contains one marker
    string from making the rebase permanently un-continuable."""
    try:
        content = (root / path).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return False
    found = set()
    for line in content.splitlines():
        for marker in ("<<<<<<<", "=======", ">>>>>>>"):
            if line.startswith(marker):
                found.add(marker)
    return len(found) == 3


def _continue(workspace: repo.Workspace, prefix: str) -> dict:
    entry = workspace.entry
    root = workspace.root
    branch = _in_progress_branch(
        root, prefix, entry.label, entry.default_branch
    )

    conflicts = repo.conflicted_paths(root)
    unresolved = [
        path for path in conflicts if _has_marker_triple(root, path)
    ]
    if unresolved:
        raise repo.RefusalError(
            "conflict markers still present in "
            f"{', '.join(unresolved)}; resolve them before 'continue'"
        )
    # Second layer of the local-only sweep guard: nothing that will ride
    # into the continued commit may be a local-only file.
    riding = conflicts + [
        path
        for index_state, _, path in repo.status_entries(root)
        if index_state not in " ?"
    ]
    swept = policy.local_only_matches(riding)
    if swept:
        raise repo.RefusalError(policy.refusal_message(
            swept, "Gitignore them or resolve the rebase by hand."
        ))

    if conflicts:
        # Stage exactly the resolutions -- `add -A` would sweep unrelated
        # files dropped into the worktree since the conflict stop.
        result = run.run(["add", "--", *conflicts], root)
        if result.returncode != 0:
            detail = (
                result.stderr.strip() or result.stdout.strip() or "no output"
            )
            raise run.GitError(f"git add failed: {detail}")
    # Read before continuing: a completed rebase takes the record with it.
    onto = _recorded_onto(root)
    resolved = _record_conflicts(root, conflicts)
    result = run.run(["rebase", "--continue"], root)
    if result.returncode != 0:
        if repo.rebase_head_branch(root) is not None:
            _conflict_stop(workspace, branch, onto, prefix)
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise run.GitError(f"git rebase --continue failed: {detail}")

    return {
        "repo": entry.label,
        "mode": "continue",
        "branch": branch,
        "onto": onto[0] if onto is not None else None,
        "resolved": resolved,
        "commit": repo.head_commit(root),
        "worktree": str(root),
    }


def _abort(workspace: repo.Workspace, prefix: str) -> dict:
    entry = workspace.entry
    root = workspace.root
    branch = _in_progress_branch(
        root, prefix, entry.label, entry.default_branch
    )
    result = run.run(["rebase", "--abort"], root)
    if result.returncode != 0:
        detail = result.stderr.strip() or result.stdout.strip() or "no output"
        raise run.GitError(f"git rebase --abort failed: {detail}")
    return {
        "repo": entry.label,
        "mode": "abort",
        "branch": branch,
        "commit": repo.head_commit(root),
        "worktree": str(root),
    }


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
