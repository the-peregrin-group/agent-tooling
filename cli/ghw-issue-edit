#!/usr/bin/python3
"""ghw-issue-edit <repo> <add-label|remove-label|retitle|set-body> <issue#> <value> -- edit one facet of an issue.

The subverb sits at position 2 so an allowlist grant can include label edits
while withholding set-body. For set-body, <value> is a body *file* path from
the staging directories, never inline text.

add-label and remove-label enforce the attachment contract against the
repo's Tracker Schema, read from TRACKER.md on its default branch, and print
every problem in it as a warning on stderr. add-label refuses a label the
schema does not declare or the live registry lacks, and a second kind
label, naming the incumbent -- reclassifying an issue is two visible calls,
remove-label then add-label. remove-label refuses to remove an issue's last
label on an axis the schema marks as carried by every Issue. A rule whose
part of the schema is missing or unusable is skipped with a warning, and
the edit goes ahead on what can still be checked. retitle and set-body need
nothing from the schema and do not read it.

Exit codes: 0 success (including a converged no-op), 1 unclassified gh/API
failure, 2 usage error, 3 not found, 4 refused: a label edit violates the
attachment contract (an undeclared label, a label missing from the
registry, a second kind label, the last label of a required axis), 5 auth
failure, 6 network failure (retryable).
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.github import boards, gh, labels, repo_schema

_USAGE = (
    "ghw-issue-edit <owner/repo> <add-label|remove-label|retitle|set-body> "
    "<issue#> <value>"
)
_SUBVERBS = ("add-label", "remove-label", "retitle", "set-body")


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 4:
        plan.usage_die("expected exactly four arguments", _USAGE)
    repository, subverb, issue_argument, value = argv
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if subverb not in _SUBVERBS:
        plan.usage_die(
            f"subverb must be one of {'|'.join(_SUBVERBS)}, got {subverb!r}", _USAGE
        )
    number = arguments.parse_issue_number(issue_argument)
    if number is None:
        plan.usage_die(
            f"issue number must be a positive integer, got {issue_argument!r}", _USAGE
        )
    if subverb == "set-body":
        body = staging.read_staged_body(value)
    elif not value.strip():
        plan.usage_die(f"{subverb} requires a non-empty value", _USAGE)

    try:
        if subverb == "add-label":
            changed = _add_label(repository, number, value, _rules(repository))
        elif subverb == "remove-label":
            changed = _remove_label(repository, number, value, _rules(repository))
        elif subverb == "retitle":
            changed = _retitle(repository, number, value)
        else:
            changed = _set_body(repository, number, body)
    except labels.LabelContractError as error:
        gh.die(str(error), plan.EXIT_REFUSED)
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)

    plan.emit_plan(
        "applied",
        repository=repository,
        issue=number,
        subverb=subverb,
        value=value,
        changed=changed,
    )
    return plan.EXIT_OK


def _current_label_names(repository: str, number: int) -> list[str]:
    """The issue's currently attached label names, freshly fetched."""
    issue = gh.issue_view(repository, number, ["labels"])
    return [label["name"] for label in issue["labels"]]


def _rules(repository: str) -> labels.LabelRules:
    """The repo's label rules, its schema's warnings and the rules it
    cannot back already printed on stderr."""
    rules = labels.LabelRules(repo_schema.load(repository))
    for line in rules.unchecked():
        print(line, file=sys.stderr)
    return rules


def _add_label(repository: str, number: int, label: str,
               rules: labels.LabelRules) -> bool:
    """Attach `label` under the attachment contract; True when a write
    happened, False on the converged no-op. Raises LabelContractError on an
    undeclared label, a registry miss, or a second kind label."""
    registry = {entry["name"] for entry in boards.fetch_labels(repository)}
    current = _current_label_names(repository, number)
    labels.validate_label_addition(label, current, registry, rules)
    if label in current:
        return False
    gh.issue_edit_labels(repository, number, add=[label], remove=[])
    return True


def _remove_label(repository: str, number: int, label: str,
                  rules: labels.LabelRules) -> bool:
    """Detach `label`; True when a write happened, False on the converged
    no-op (the label was already absent). Raises LabelContractError when it
    is the issue's last label on a required axis."""
    current = _current_label_names(repository, number)
    if label not in current:
        return False
    labels.validate_label_removal(label, current, rules)
    gh.issue_edit_labels(repository, number, add=[], remove=[label])
    return True


def _retitle(repository: str, number: int, title: str) -> bool:
    """Retitle the issue; True when a write happened, False on the converged
    no-op (the title already matches)."""
    if gh.issue_view(repository, number, ["title"])["title"] == title:
        return False
    gh.issue_edit_title(repository, number, title)
    return True


def _set_body(repository: str, number: int, body: str) -> bool:
    """Replace the issue's body; True when a write happened, False on the
    converged no-op (the body already matches)."""
    if gh.issue_view(repository, number, ["body"])["body"] == body:
        return False
    gh.issue_edit_body(repository, number, body)
    return True


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
