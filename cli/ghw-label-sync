#!/usr/bin/env python3
"""ghw-label-sync <repo> <plan|apply|apply-delete> <schema-file> -- sync a repo's labels to a declared schema.

Declarative and idempotent: the desired registry is the five canonical type
labels (from the shared schema constants, never redeclared in a file) plus the
repo-specific `area:` and scope families the JSON schema file declares, plus
P0-P3 when the file sets "priority_labels": true. Anything in the repo and not
in that set is a deletion candidate -- which is how GitHub's nine stock labels
get cleared at bootstrap.

Modes are positional because deletion authority is granted by allowlisting a
mode, never by a trailing flag:
    plan          pure read; prints the full diff and writes nothing
    apply         creates missing labels and fixes color/description drift;
                  deletes are computed and printed but NOT executed
    apply-delete  the above, and executes the deletes, open issues included

Whenever a deletion candidate is attached to open issues, every mode prints
those issues to stderr -- plan is exactly where a human decides whether to
grant deletion, so that is where the warning most needs to land. The same
issues ride the JSON plan on stdout.

The schema file is read under the staging-directory policy: its
content is published to GitHub, so it comes from /tmp/claude/ or
~/.claude/jobs/<job-id>/tmp/ like any other file a wrapper reads.

Exit codes: 0 success (including a converged no-op), 1 gh/API failure,
2 usage error or policy refusal.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.github import boards, gh, label_schema

_USAGE = "ghw-label-sync <owner/repo> <plan|apply|apply-delete> <schema-file>"
_MODES = ("plan", "apply", "apply-delete")


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 3:
        plan.usage_die("expected exactly three arguments", _USAGE)
    repository, mode, schema_argument = argv
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if mode not in _MODES:
        plan.usage_die(
            f"mode must be one of {'|'.join(_MODES)}, got {mode!r}", _USAGE
        )
    text = staging.read_staged_body(schema_argument, description="schema file")
    try:
        schema = label_schema.parse_schema(text)
    except label_schema.SchemaFileError as error:
        gh.die(f"{schema_argument}: {error}", plan.EXIT_USAGE)

    done: list[str] = []
    try:
        difference = label_schema.diff_labels(
            label_schema.desired_labels(schema), boards.fetch_labels(repository)
        )
        deletions = _deletion_report(repository, difference["delete"])
        # Always before _apply: in apply-delete the warning is the only record
        # of what a delete detached, and it must survive a mid-loop failure.
        _warn_about_attached_issues(deletions, mode)
        _apply(repository, difference, mode, done)
    except gh.GhError as error:
        gh.die(_failure_message(error, done), plan.EXIT_RUNTIME)

    plan.emit_plan(
        "plan" if mode == "plan" else "applied",
        repository=repository,
        mode=mode,
        create=difference["create"],
        update=difference["update"],
        delete=deletions,
        unchanged=difference["unchanged"],
        case_mismatch=difference["case_mismatch"],
        deletes_executed=mode == "apply-delete",
        changed=bool(done),
    )
    return plan.EXIT_OK


def _deletion_report(repository: str, names: list[str]) -> list[dict]:
    """Each deletion candidate with the open issues it is attached to.

    Only candidates are queried, so a converged repo costs no extra calls.
    `open_issue_count` is the server-side total; `open_issues` may hold fewer
    of them, and the warning says so rather than understating the blast radius.
    """
    report = []
    for name in names:
        attached = boards.fetch_open_issues_with_label(repository, name)
        report.append({
            "name": name,
            "open_issue_count": attached["total"],
            "open_issues": [
                {"number": issue["number"], "title": issue["title"],
                 "url": issue["url"]}
                for issue in attached["issues"]
            ],
        })
    return report


def _warn_about_attached_issues(deletions: list[dict], mode: str) -> None:
    """Print the attached-open-issues warning on stderr, in every mode.

    stderr, not stdout, because stdout carries the JSON plan; the same issues
    are in that payload under "delete". The wording is prospective in every
    mode because this prints before any delete runs -- claiming a deletion
    happened would be a lie if the delete then failed.
    """
    attached = [entry for entry in deletions if entry["open_issue_count"]]
    if not attached:
        return
    consequence = {
        "plan": "Nothing will be written in plan mode. Deleting them would "
                "strip the label from these issues.",
        "apply": "These deletions will NOT be executed. Re-run with the "
                 "apply-delete mode to execute them.",
        "apply-delete": "These deletions are about to be executed, stripping "
                        "the label from these issues.",
    }[mode]
    lines = ["warning: the following labels are attached to open issues:"]
    for entry in attached:
        shown = len(entry["open_issues"])
        total = entry["open_issue_count"]
        suffix = f" (showing {shown} of {total})" if shown < total else ""
        lines.append(f"  {entry['name']}{suffix}")
        for issue in entry["open_issues"]:
            lines.append(f"    {issue['url']}  {issue['title']}")
    lines.append(consequence)
    print("\n".join(lines), file=sys.stderr)


def _apply(repository: str, difference: dict, mode: str, done: list[str]) -> None:
    """Execute the diff for `mode`, appending a description of each write to
    `done` as it lands.

    plan writes nothing. apply creates and drift-fixes. apply-delete also
    deletes. Creates run before deletes so a rename-shaped schema change never
    leaves the repo with neither label. `done` is the caller's list so a
    failure part-way through can still report what did happen -- a bare exit 1
    with empty stdout would leave the repo in an unknown state.
    """
    if mode == "plan":
        return
    for label in difference["create"]:
        gh.label_create(
            repository, label["name"], label["color"], label["description"]
        )
        done.append(f"created {label['name']}")
    for label in difference["update"]:
        gh.label_edit(
            repository, label["name"], label["color"], label["description"]
        )
        done.append(f"updated {label['name']}")
    if mode == "apply-delete":
        for name in difference["delete"]:
            gh.label_delete(repository, name)
            done.append(f"deleted {name}")


def _failure_message(error: gh.GhError, done: list[str]) -> str:
    """The GhError, plus whatever had already been written when it hit."""
    if not done:
        return str(error)
    return f"{error}\nWrites that had already landed: {', '.join(done)}"


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
