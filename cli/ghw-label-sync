#!/usr/bin/python3
"""ghw-label-sync <repo> <plan|apply|apply-delete> -- sync a repo's labels to its Tracker Schema.

Declarative and idempotent. The desired labels are exactly what the repo's
Tracker Schema declares, read from TRACKER.md on its default branch: a Kind
Label for every Issue Kind, every Issue Priority where the repo carries
priority as labels (the "p-labels" priority regime, judged from the boards
linked on GitHub alone: no local file, TRIAGE.md included, is read), every
axis's labels, and every label on no axis, each with the schema's
description and colour. A label's description or colour that differs from
the schema's is drift, fixed by apply. Anything in the repo and not in that
set is a deletion candidate, which is how GitHub's stock labels get cleared
at bootstrap, except a label named for an Issue State, which that state
declares (the sync keeps it but does not create it). To change a repo's
labels, change its TRACKER.md and merge it to the default branch, then
sync.

A name gh cannot pass whole (one holding a comma, or starting with '-') is
never passed to gh: declared, it is neither created nor deleted; live and
undeclared, it is left for a person to delete. Either way a warning names
it.

Modes are positional because deletion authority is granted by allowlisting a
mode, never by a trailing flag:
    plan          pure read; prints the full diff and writes nothing
    apply         creates missing labels and fixes color/description drift;
                  deletes are computed and printed but NOT executed
    apply-delete  the above, and executes the deletes, open issues included

Every problem in TRACKER.md is printed as a warning on stderr. A section
the reader cannot use adds no labels; plan and apply go ahead with the
rest. Deletion is trusted only when every section the desired set comes
from is complete: otherwise plan and apply list no deletion candidates and
say why under "delete_refused", and apply-delete is refused (exit 4) before
any write, naming the section. A repo with no TRACKER.md is treated the
same way, so a plan with nothing to create and a delete_refused saying the
file is not found means TRACKER.md has not been merged yet. When the
schema could not be fetched for a network or auth failure, apply-delete
exits with that failure's code (6 or 5) instead. With the priority regime
unknown, the schema's priority labels are neither created nor deleted, and
the same holds on board-field when the board's Priority field does not
hold every declared priority, with a warning naming the mismatch: only a
board that holds them all shows that priority lives there and not in the
labels.

Whenever a deletion candidate is attached to open issues, every mode prints
those issues to stderr -- plan is exactly where a human decides whether to
grant deletion, so that is where the warning most needs to land. The same
issues ride the JSON plan on stdout.

Exit codes: 0 success (including a converged no-op), 1 unclassified gh/API
failure, 2 usage error, 3 not found, 4 refused: apply-delete when the
schema cannot back a deletion, 5 auth failure, 6 network failure
(retryable), including a failure fetching TRACKER.md under apply-delete.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan
from lib.github import boards, gh, label_schema, repo_schema

_USAGE = "ghw-label-sync <owner/repo> <plan|apply|apply-delete>"
_MODES = ("plan", "apply", "apply-delete")


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 2:
        plan.usage_die("expected exactly two arguments", _USAGE)
    repository, mode = argv
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if mode not in _MODES:
        plan.usage_die(
            f"mode must be one of {'|'.join(_MODES)}, got {mode!r}", _USAGE
        )

    loaded = repo_schema.load(repository)
    done: list[str] = []
    try:
        regime, board_priorities = _priority_regime(repository)
        desired = label_schema.desired_labels(loaded, regime, board_priorities)
        for note in desired.notes:
            print(note, file=sys.stderr)
        delete_refused = _deletion_refusal(loaded, desired)
        if delete_refused is not None and mode == "apply-delete":
            gh.die(
                f"apply-delete refused: deleting labels needs every section "
                f"the desired set comes from to be complete, and {delete_refused}. "
                "Fix TRACKER.md on the default branch, or run apply, which "
                "deletes nothing.",
                loaded.refusal_exit_code(),
            )
        difference = label_schema.diff_labels(
            desired, boards.fetch_labels(repository)
        )
        if delete_refused is not None:
            difference["delete"] = []
        if difference["uncarriable"]:
            print("warning: these labels are not in the Tracker Schema, but "
                  "gh cannot pass their names whole, so ghw-label-sync does "
                  "not delete them; delete them by hand: "
                  + ", ".join(repr(name) for name in difference["uncarriable"]),
                  file=sys.stderr)
        deletions = _deletion_report(repository, difference["delete"])
        # Always before _apply: in apply-delete the warning is the only record
        # of what a delete detached, and it must survive a mid-loop failure.
        _warn_about_attached_issues(deletions, mode)
        _apply(repository, difference, mode, done)
    except gh.GhError as error:
        gh.die(_failure_message(error, done), error.exit_code)

    plan.emit_plan(
        "plan" if mode == "plan" else "applied",
        repository=repository,
        mode=mode,
        tracker_schema=loaded.summary(),
        priority_regime=regime,
        create=difference["create"],
        update=difference["update"],
        delete=deletions,
        delete_refused=delete_refused,
        unchanged=difference["unchanged"],
        case_mismatch=difference["case_mismatch"],
        deletes_executed=mode == "apply-delete",
        changed=bool(done),
    )
    return plan.EXIT_OK


def _priority_regime(repository: str) -> tuple:
    """(the repo's priority regime, the option names of the canonical
    board's Priority field or None), judged from its linked boards on the
    forge alone. No local file is an input: a TRIAGE.md in the working
    directory, which ghw-orient uses to pick among several boards, plays no
    part, so with several boards linked the regime is unknown and the
    priority labels are neither created nor deleted."""
    linked = boards.fetch_boards(repository)
    canonical, _rule, _note = boards.resolve_canonical_board(
        repository, linked, None
    )
    return (boards.determine_priority_regime(canonical, linked),
            boards.priority_options(canonical))


def _deletion_refusal(loaded: repo_schema.RepoSchema,
                      desired: label_schema.DesiredLabels) -> str | None:
    """Why the schema cannot back a deletion, or None when it can."""
    try:
        loaded.require_complete(*desired.sections)
    except repo_schema.SchemaIncomplete as error:
        return str(error)
    return None


def _deletion_report(repository: str, names: list[str]) -> list[dict]:
    """Each deletion candidate with the open issues it is attached to.

    Only candidates are queried, so a converged repo costs no extra calls.
    `open_issue_count` is the server-side total; `open_issues` may hold fewer
    of them, and the warning says so rather than understating the blast radius.
    """
    report = []
    for name in names:
        attached = boards.fetch_open_issues_with_label(repository, name)
        report.append({
            "name": name,
            "open_issue_count": attached["total"],
            "open_issues": [
                {"number": issue["number"], "title": issue["title"],
                 "url": issue["url"]}
                for issue in attached["issues"]
            ],
        })
    return report


def _warn_about_attached_issues(deletions: list[dict], mode: str) -> None:
    """Print the attached-open-issues warning on stderr, in every mode.

    stderr, not stdout, because stdout carries the JSON plan; the same issues
    are in that payload under "delete". The wording is prospective in every
    mode because this prints before any delete runs -- claiming a deletion
    happened would be a lie if the delete then failed.
    """
    attached = [entry for entry in deletions if entry["open_issue_count"]]
    if not attached:
        return
    consequence = {
        "plan": "Nothing will be written in plan mode. Deleting them would "
                "strip the label from these issues.",
        "apply": "These deletions will NOT be executed. Re-run with the "
                 "apply-delete mode to execute them.",
        "apply-delete": "These deletions are about to be executed, stripping "
                        "the label from these issues.",
    }[mode]
    lines = ["warning: the following labels are attached to open issues:"]
    for entry in attached:
        shown = len(entry["open_issues"])
        total = entry["open_issue_count"]
        suffix = f" (showing {shown} of {total})" if shown < total else ""
        lines.append(f"  {entry['name']}{suffix}")
        for issue in entry["open_issues"]:
            lines.append(f"    {issue['url']}  {issue['title']}")
    lines.append(consequence)
    print("\n".join(lines), file=sys.stderr)


def _apply(repository: str, difference: dict, mode: str, done: list[str]) -> None:
    """Execute the diff for `mode`, appending a description of each write to
    `done` as it lands.

    plan writes nothing. apply creates and drift-fixes. apply-delete also
    deletes. Creates run before deletes so a rename-shaped schema change never
    leaves the repo with neither label. `done` is the caller's list so a
    failure part-way through can still report what did happen -- a bare exit 1
    with empty stdout would leave the repo in an unknown state.
    """
    if mode == "plan":
        return
    for label in difference["create"]:
        gh.label_create(
            repository, label["name"], label["color"], label["description"]
        )
        done.append(f"created {label['name']}")
    for label in difference["update"]:
        gh.label_edit(
            repository, label["name"], label["color"], label["description"]
        )
        done.append(f"updated {label['name']}")
    if mode == "apply-delete":
        for name in difference["delete"]:
            gh.label_delete(repository, name)
            done.append(f"deleted {name}")


def _failure_message(error: gh.GhError, done: list[str]) -> str:
    """The GhError, plus whatever had already been written when it hit."""
    if not done:
        return str(error)
    return f"{error}\nWrites that had already landed: {', '.join(done)}"


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
