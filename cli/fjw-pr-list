#!/usr/bin/python3
"""fjw-pr-list <owner/repo> -- list open pull requests as raw API JSON.

Read verb: emits the raw Forgejo PR objects (an array, paginated to
exhaustion, open PRs only -- the one state the unattended consumer ever
lists). Acts as the deployment's machine account.

Exit codes: 0 success (an empty array is success), 1 unclassified API
failure, 2 usage error, 3 repository not found, 5 auth/config failure,
6 network failure.
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import plan
from lib.forgejo import api, config as fjw_config, pulls

_USAGE = "fjw-pr-list <owner/repo>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 1:
        plan.usage_die("expected exactly one argument", _USAGE)
    repository = argv[0]
    if not pulls.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)

    try:
        configuration = fjw_config.load()
    except fjw_config.ConfigError as error:
        api.die(str(error), plan.EXIT_AUTH)
    try:
        prs = pulls.list_open_prs(configuration, repository)
    except api.ApiError as error:
        api.die(str(error), error.exit_code)

    print(json.dumps(prs, indent=2))
    return plan.EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
