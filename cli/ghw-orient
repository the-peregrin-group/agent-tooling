#!/usr/bin/python3
"""ghw-orient <repo> -- one read-only JSON orientation blob for a GitHub repo.

Replaces the multi-call Step-1 dance of the use-github skill: repo identity,
the live label registry, every open linked ProjectV2 board with its field and
option name-to-ID maps (and each option's colour and description), which
board is canonical (and by which rule), and which priority regime the repo
is in ("board-field" when the canonical board has a single-select Priority
field, "p-labels" when no board is linked, "unknown" otherwise).

It reads the repo's Tracker Schema, TRACKER.md on its default branch,
prints every problem in it as a warning on stderr, and reports under
"tracker_schema" which file it read, whether it could be read at all, and
how many warnings it gave. A missing or broken TRACKER.md never fails
orientation.

Each board carries a "conformance" verdict against that schema: its Status
options should be exactly the Issue States and its Priority options
exactly the Issue Priorities, in the schema's order, beside the fixed Size
and Last Triaged fields. The verdict names every difference (a missing or
undeclared option, options out of order, an absent field), lists options
whose colour differs from the schema's, and says which fields it could not
check because a section of the schema cannot be read. It is advisory:
orient reports, and ghw-board-sync is what acts. "priority_labels_present"
lists which of the schema's Issue Priorities exist as labels, or is null
when the priorities cannot be read.

IDs are resolved live on every call; there is no on-disk cache.

Exit codes: 0 success, 1 unclassified gh/API failure, 2 usage error,
3 not found, 5 auth failure, 6 network failure (retryable).
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, tracker_schema
from lib.github import board_schema, boards, gh, repo_schema

_USAGE = "ghw-orient <owner/repo>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 1:
        plan.usage_die("expected exactly one argument", _USAGE)
    repository = argv[0]
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)

    try:
        orientation = boards.fetch_orientation(repository)
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)
    loaded = repo_schema.load(repository)

    triage_profile = boards.find_triage_profile(Path.cwd())
    canonical, rule, note = boards.resolve_canonical_board(
        repository, orientation["boards"], triage_profile
    )
    fields = board_schema.desired_fields(loaded)
    for board in orientation["boards"]:
        board["conformance"] = board_schema.evaluate_conformance(board, fields)
    priorities = loaded.section(tracker_schema.ISSUE_PRIORITIES)

    plan.emit({
        **orientation,
        "canonical_board": canonical["number"] if canonical else None,
        "canonical_rule": rule,
        "canonical_note": note,
        "priority_regime": boards.determine_priority_regime(
            canonical, orientation["boards"]
        ),
        "priority_labels_present": boards.priority_labels_present(
            orientation["labels"],
            None if priorities is None else [p.name for p in priorities],
        ),
        "tracker_schema": loaded.summary(),
    })
    return plan.EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
