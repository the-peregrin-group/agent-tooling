#!/usr/bin/python3
"""ghw-issue-close <repo> <issue#> <comment-file> -- close an issue with its reason.

Its own verb, never a flag on ghw-issue-edit, so closing is independently
grantable or withheld. The comment file (staging directories only, never
inline) is mandatory: the closing comment is the audit record of why the issue
was closed, so a silent close is inexpressible. A blank comment is refused.
Closing an already-closed issue is a converged no-op; the comment is NOT
posted, since the close it was meant to explain did not happen here.
The comment-file slot takes no flags: a path beginning with '-' is a usage
error (spell such a path './-name').

Exit codes: 0 success (including a converged no-op), 1 gh/API failure,
2 usage error or policy refusal (including a missing or blank comment).
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.github import gh

_USAGE = "ghw-issue-close <owner/repo> <issue#> <comment-file>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 3:
        plan.usage_die(
            "expected three arguments; the closing comment is required: write "
            "the reason to a unique file under /tmp/claude/ (or your job's "
            "tmp directory) and pass it as <comment-file>",
            _USAGE,
        )
    repository, issue_argument, comment_path = argv
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    number = arguments.parse_issue_number(issue_argument)
    if number is None:
        plan.usage_die(
            f"issue number must be a positive integer, got {issue_argument!r}", _USAGE
        )
    if arguments.is_flag_shaped(comment_path):
        plan.usage_die(f"ghw-issue-close takes no flags, got {comment_path!r}", _USAGE)
    comment = staging.read_staged_body(comment_path, description="comment file")
    if not comment.strip():
        plan.usage_die(
            f"comment file {comment_path!r} is blank; the closing comment is "
            "required, so write the reason into it",
            _USAGE,
        )

    try:
        state = gh.issue_view(repository, number, ["state"])["state"]
        if state != "OPEN":
            plan.emit_plan(
                "applied",
                repository=repository,
                issue=number,
                changed=False,
                note=f"issue is already {state}; comment not posted",
            )
            return plan.EXIT_OK
        gh.issue_close(repository, number, comment)
    except gh.GhError as error:
        gh.die(str(error), plan.EXIT_RUNTIME)

    plan.emit_plan(
        "applied",
        repository=repository,
        issue=number,
        changed=True,
        commented=True,
    )
    return plan.EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
