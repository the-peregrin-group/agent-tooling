#!/usr/bin/python3
"""ghw-board-set <repo> <field-name> <option-name> <issue#> [--project <number>] -- set a board field on an issue.

The field name sits at position 2 so an allowlist rule can grant Priority
without Status. Adds the issue to the board first when it is missing, then
sets the field; names resolve to IDs internally, live, per call. Idempotent:
when the field already holds the option, nothing is written and the plan says
changed: false.

For `Status` and `Priority`, whose options are the repo's Issue States and
Issue Priorities, the value must also be one the repo's Tracker Schema
declares (TRACKER.md on its default branch): an undeclared value is a
usage error (exit 2) naming it, even where the board still carries it, as
a board not yet migrated may. A declared value the board lacks is refused
(exit 4) with the ghw-board-sync call that adds it. When the schema, or
the section the field's values come from, cannot be read, its warnings
print and the write goes ahead on the board's own check. Other fields are
checked against the board alone, and the schema is not read.

Board choice follows the canonical-board rules: the only linked board
wins; among several, a TRIAGE.md discovered from cwd (bounded to the enclosing
git work tree) decides if it names this repo; otherwise this wrapper refuses
and lists the candidates. A trailing --project <number> picks a linked board
explicitly -- trailing position is safe because it only narrows a grant
already given.

Exit codes: 0 success (including a converged no-op), 1 unclassified gh/API
failure, 2 usage error, including a Status or Priority value the Tracker
Schema does not declare, 3 not found, 4 refused: --project names a board not
linked to <repo>, no canonical board resolves, or the board has no such
single-select field or option, 5 auth failure, 6 network failure (retryable).
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, tracker_schema
from lib.github import board_schema, boards, gh, repo_schema

# How a refusal names the schema section a field's values come from.
_SECTION_NAMES = {
    field: {tracker_schema.ISSUE_STATES: "Issue States",
            tracker_schema.ISSUE_PRIORITIES: "Issue Priorities"}[section]
    for field, section in board_schema.SECTIONS.items()
}

_USAGE = (
    "ghw-board-set <owner/repo> <field-name> <option-name> <issue#> "
    "[--project <number>]"
)


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) not in (4, 6):
        plan.usage_die(
            "expected four positional arguments, optionally followed by "
            "--project <number>",
            _USAGE,
        )
    repository, field_name, option_name, issue_argument = argv[:4]
    project_override = None
    if len(argv) == 6:
        if argv[4] != "--project":
            plan.usage_die(
                f"only --project may follow the positional block, got {argv[4]!r}",
                _USAGE,
            )
        project_override = arguments.parse_issue_number(argv[5])
        if project_override is None:
            plan.usage_die(
                f"--project takes a positive integer, got {argv[5]!r}", _USAGE
            )
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    number = arguments.parse_issue_number(issue_argument)
    if number is None:
        plan.usage_die(
            f"issue number must be a positive integer, got {issue_argument!r}", _USAGE
        )

    loaded, declared = _declared_options(repository, field_name)
    if declared is not None and option_name not in declared:
        plan.usage_die(
            f"{option_name!r} is not one of the repo's "
            f"{_SECTION_NAMES[field_name]} in {loaded.source}, so it is not "
            f"a {field_name} value. Declared: {', '.join(declared)}",
            _USAGE,
        )

    try:
        linked_boards = boards.fetch_boards(repository)
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)

    board = _select_board(repository, linked_boards, project_override)
    field = board["fields"].get(field_name)
    if field is None:
        gh.die(
            f"board #{board['number']} ({board['title']}) has no field "
            f"{field_name!r}. Fields: {', '.join(sorted(board['fields']))}",
            plan.EXIT_REFUSED,
        )
    if field["data_type"] != "SINGLE_SELECT":
        gh.die(
            f"field {field_name!r} is {field['data_type']}, not SINGLE_SELECT; "
            "only single-select fields are settable by option name",
            plan.EXIT_REFUSED,
        )
    option_id = field["options"].get(option_name)
    if option_id is None:
        hint = ""
        if declared is not None:
            hint = (f" The Tracker Schema declares it, so the board lags the "
                    f"schema: `ghw-board-sync {repository} apply "
                    f"{board['number']}` adds it.")
        gh.die(
            f"field {field_name!r} has no option {option_name!r}. "
            f"Options: {', '.join(field['options'])}.{hint}",
            plan.EXIT_REFUSED,
        )
    extra = {} if loaded is None else {"tracker_schema": loaded.summary()}

    try:
        state = boards.fetch_issue_item_state(repository, number, field_name)
        item = state["items"].get(board["node_id"])
        if item is not None and item["option_id"] == option_id:
            plan.emit_plan(
                "applied",
                repository=repository,
                issue=number,
                board=board["number"],
                field=field_name,
                option=option_name,
                changed=False,
                **extra,
            )
            return plan.EXIT_OK
        if item is None:
            item_id = boards.add_item_to_board(
                board["node_id"], state["issue_node_id"]
            )
        else:
            item_id = item["item_id"]
        boards.set_single_select_value(
            board["node_id"], item_id, field["id"], option_id
        )
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)

    plan.emit_plan(
        "applied",
        repository=repository,
        issue=number,
        board=board["number"],
        field=field_name,
        option=option_name,
        changed=True,
        added_to_board=item is None,
        **extra,
    )
    return plan.EXIT_OK


def _declared_options(
    repository: str, field_name: str
) -> tuple[repo_schema.RepoSchema | None, list[str] | None]:
    """The repo's Tracker Schema and the values it declares for
    `field_name`, for a field whose options the schema decides (Status,
    Priority). For any other field the schema is not read: (None, None).
    The values are None when the section cannot be read; the loader has
    then already warned, and the write goes ahead on the board's own
    check alone."""
    section = board_schema.SECTIONS.get(field_name)
    if section is None:
        return None, None
    loaded = repo_schema.load(repository)
    entries = loaded.section(section)
    if entries is None:
        return loaded, None
    return loaded, [entry.name for entry in entries]


def _select_board(
    repository: str, linked_boards: list[dict], project_override: int | None
) -> dict:
    """Pick the target board, refusing (exit 4) when none resolves."""
    if project_override is not None:
        for board in linked_boards:
            if board["number"] == project_override:
                return board
        candidates = ", ".join(
            f"#{board['number']} ({board['title']})" for board in linked_boards
        ) or "none"
        gh.die(
            f"project #{project_override} is not linked to {repository}. "
            f"Linked boards: {candidates}",
            plan.EXIT_REFUSED,
        )
    profile = boards.find_triage_profile(Path.cwd())
    board, rule, note = boards.resolve_canonical_board(
        repository, linked_boards, profile
    )
    if board is None:
        gh.die(
            f"cannot resolve a canonical board ({rule}): "
            f"{note or f'no boards linked to {repository}'}. "
            "Pass --project <number> to choose one explicitly.",
            plan.EXIT_REFUSED,
        )
    return board


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
