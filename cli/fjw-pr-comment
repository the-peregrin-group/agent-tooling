#!/usr/bin/python3
"""fjw-pr-comment <owner/repo> <head-prefix> <pr#> <body-file> -- comment on a PR whose head branch matches a claimed prefix.

The head-prefix is a positional scope token: an allowlist rule pins it (e.g.
`Bash(fjw-pr-comment owner/repo reconcile/ *)`), and the wrapper
trust-but-verifies the claim -- it fetches the PR and refuses (exit 4) when
the actual head branch does not start with the claimed prefix. Policy lives
in the allowlist layer; this wrapper stays consumer-generic. Standalone
comments on arbitrary PRs are deliberately inexpressible: there is no
prefix-free form. Acts as the deployment's machine account.

Exit codes: 0 success, 1 unclassified API failure, 2 usage error, 3 no such
PR (or no such repository), 4 refused (head branch does not match the
claimed prefix), 5 auth/config failure, 6 network failure.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.forgejo import api, config as fjw_config, pulls

_USAGE = "fjw-pr-comment <owner/repo> <head-prefix> <pr#> <body-file>"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) != 4:
        plan.usage_die("expected exactly four arguments", _USAGE)
    repository, head_prefix, raw_index, body_path = argv
    if not pulls.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if not head_prefix.strip():
        plan.usage_die("head-prefix must not be empty", _USAGE)
    index = arguments.parse_issue_number(raw_index)
    if index is None:
        plan.usage_die(f"pr# must be a positive integer, got {raw_index!r}", _USAGE)
    body = staging.read_staged_body(body_path)

    try:
        configuration = fjw_config.load()
    except fjw_config.ConfigError as error:
        api.die(str(error), plan.EXIT_AUTH)

    try:
        pr = pulls.get_pr(configuration, repository, index)
    except api.ApiError as error:
        api.die(str(error), error.exit_code)
    actual_head = (pr.get("head") or {}).get("ref") or ""
    if not actual_head.startswith(head_prefix):
        api.die(
            f"PR #{index} has head branch {actual_head!r}, which does not "
            f"match the claimed prefix {head_prefix!r}",
            plan.EXIT_REFUSED,
        )

    try:
        posted = pulls.create_comment(configuration, repository, index, body)
    except api.ApiError as error:
        api.die(str(error), error.exit_code)

    plan.emit_plan(
        "applied",
        repository=repository,
        pr=index,
        head=actual_head,
        comment=posted.get("id"),
        url=posted.get("html_url"),
    )
    return plan.EXIT_OK


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
