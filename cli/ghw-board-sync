#!/usr/bin/python3
"""ghw-board-sync <repo> <new | plan|apply|migrate <project#> [--move ...]> -- sync a board to the Tracker Schema.

The board a repo's Tracker Schema asks for, read from TRACKER.md on its
default branch: a `Status` field whose options are exactly the repo's
Issue States, and a `Priority` field whose options are exactly its Issue
Priorities, each in the schema's order and in the named board colour
nearest the schema's colour, beside the fixed `Size` (XS to XL) and `Last
Triaged` (a date) fields. To change a board's states or priorities, change
TRACKER.md and merge it to the default branch, then sync.

Modes are positional, because what a grant allows is the mode:

    new      create a ProjectV2 titled after the repo, link it to <repo>,
             and provision every field, `Size` included. The board's stock
             Status options are replaced by the Issue States; it has no
             items yet, so nothing is lost. Refused when the repo already
             has a linked open board, so a repeated bootstrap cannot
             silently produce two.
    plan     a pure read. Prints what apply and migrate would do: fields to
             create, options to add, recolour, or reorder, and every option
             the schema does not declare, with the items on it and where
             each would move.
    apply    additive: creates missing fields (not `Size` on an existing
             board, which is reported instead) and adds, recolours, and
             reorders options, keeping every live option and every value
             items hold. Removes nothing.
    migrate  apply, then the destructive part: moves every item off each
             option the schema does not declare, and only then removes
             those options.

Given a project number, the board must already be linked to <repo> (a scope
claim the Verb verifies rather than trusts).

Removing an option from a single-select clears it on every item that held
it, so migrate moves the items first. An item on a removed `Status` option
moves to the one declared Issue State whose open flag matches its issue or
pull request, when exactly one does (with the default schema, a closed
issue on Done or Rejected moves to Closed). Any other item needs a named
move, `--move <field> <option> <to>`, which sends every item on <option>
in <field> (Status or Priority) to the declared option <to>; plan takes
the same moves to preview them. migrate is refused (exit 4) before any
write while an item has no target, naming each. It re-reads the board
after moving and is refused, still before any removal, if an item holds a
removed option again or the board has gained an option the plan did not
cover. A re-run after any failure converges.

Every problem in TRACKER.md prints as a warning on stderr. Where the Issue
States or Issue Priorities cannot be read, that field's options are
unknown: plan reports them unchecked, and apply leaves them as they are.
new is refused when either cannot be read, since the board would start
with options the schema did not give. migrate is refused (exit 4) unless
both are complete, so that an option the reader lost is never taken for
one to remove; when TRACKER.md could not be fetched for a network or auth
failure, the refusal exits with that failure's code (6 or 5) instead.

By convention (skill text, not enforced here) new belongs to
setup-issue-tracker (its github.md).

Exit codes: 0 success (including a converged no-op), 1 unclassified gh/API
failure, including GitHub not keeping an option the write kept, 2 usage
error, including a --move that names an option migrate would not remove or
a target the schema does not declare, 3 not found, 4 refused: the project
number is not an open board linked to <repo>, new met a repo that already
has one or a schema whose states or priorities cannot be read, or migrate
met an incomplete schema, an item with no target, or a board that changed
under it, 5 auth failure, 6 network failure (retryable).
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan
from lib.github import board_schema, boards, gh, repo_schema
from lib.schema import FIELD_STATUS, SINGLE_SELECT

_USAGE = ("ghw-board-sync <owner/repo> new | <owner/repo> <plan|apply|migrate> "
          "<project#> [--move <field> <option> <to> ...]")
_MODES = ("plan", "apply", "migrate")


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    repository, mode, number, moves = _parse(argv)

    loaded = repo_schema.load(repository)
    fields = board_schema.desired_fields(loaded)
    try:
        if mode == "new":
            result = _create_board(repository, loaded, fields)
        else:
            result = _sync_board(repository, mode, number, moves, loaded, fields)
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)

    board = result.pop("board")
    plan.emit_plan(
        "plan" if mode == "plan" else "applied",
        repository=repository,
        mode=mode,
        board=board["number"],
        board_url=board.get("url"),
        tracker_schema=loaded.summary(),
        **result,
        conformance=board_schema.evaluate_conformance(board, fields),
    )
    return plan.EXIT_OK


def _parse(argv: list[str]) -> tuple:
    """(repository, mode, project number or None, {(field, option): to})."""
    if len(argv) < 2:
        plan.usage_die("expected at least two arguments", _USAGE)
    repository, mode = argv[0], argv[1]
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if mode == "new":
        if len(argv) != 2:
            plan.usage_die("'new' takes no further arguments", _USAGE)
        return repository, mode, None, {}
    if mode not in _MODES:
        hint = ""
        if arguments.parse_issue_number(mode) is not None:
            hint = (f"; to sync project #{mode}, name a mode first: "
                    f"`ghw-board-sync {repository} plan {mode}`")
        plan.usage_die(
            f"second argument must be 'new' or one of {'|'.join(_MODES)}, "
            f"got {mode!r}{hint}",
            _USAGE,
        )
    if len(argv) < 3:
        plan.usage_die(f"{mode} takes a project number", _USAGE)
    number = arguments.parse_issue_number(argv[2])
    if number is None:
        plan.usage_die(f"project number must be a positive integer, got "
                       f"{argv[2]!r}", _USAGE)
    tail = argv[3:]
    moves: dict = {}
    while tail:
        if tail[0] != "--move" or len(tail) < 4:
            plan.usage_die(
                f"only --move <field> <option> <to> may follow the project "
                f"number, got {' '.join(tail)!r}", _USAGE)
        if mode == "apply":
            plan.usage_die("apply removes nothing, so it takes no --move; "
                           "use plan or migrate", _USAGE)
        field_name, option, target = tail[1:4]
        if field_name not in board_schema.SECTIONS:
            plan.usage_die(
                f"--move takes a field whose options come from the Tracker "
                f"Schema ({', '.join(board_schema.SECTIONS)}), got "
                f"{field_name!r}", _USAGE)
        if (field_name, option) in moves:
            plan.usage_die(f"--move names {field_name} {option!r} twice", _USAGE)
        moves[(field_name, option)] = target
        tail = tail[4:]
    return repository, mode, number, moves


def _sync_board(repository: str, mode: str, number: int, moves: dict,
                loaded: repo_schema.RepoSchema,
                fields: tuple) -> dict:
    """plan, apply, or migrate one linked board."""
    linked = boards.fetch_boards(repository)
    entry = next((board for board in linked if board["number"] == number), None)
    if entry is None:
        candidates = ", ".join(
            f"#{board['number']} ({board['title']})" for board in linked
        ) or "none"
        gh.die(
            f"project #{number} is not an open board linked to {repository}. "
            f"Linked boards: {candidates}. Use 'new' to create and link one.",
            plan.EXIT_REFUSED,
        )
    board = boards.fetch_board_by_node_id(entry["node_id"])
    plans = _plans(board, fields)
    refused = _migrate_refusal(loaded)
    if mode == "migrate" and refused is not None:
        gh.die(
            f"migrate refused: removing options needs the Issue States and "
            f"Issue Priorities complete, and {refused}. Fix TRACKER.md on "
            "the default branch; apply, which removes nothing, still works.",
            loaded.refusal_exit_code(),
        )
    _check_moves(moves, plans, fields)
    states = _states(loaded)
    migration = _migration(board, plans, moves, states)
    create = [spec.name
              for spec in board_schema.fields_to_create(board, fields,
                                                        new_board=False)]
    report = {
        "created_board": False,
        "create_fields": create,
        "options": [field_plan.summary() for field_plan in plans],
        "migration": migration,
        "migrate_refused": refused,
    }
    if mode == "plan":
        return {"board": board, **report, "writes": [], "changed": False}

    if mode == "migrate":
        stranded = [item for entries in migration.values()
                    for item in board_schema.unmoved(entries)]
        if stranded:
            gh.die(_stranded_message(repository, number, migration),
                   plan.EXIT_REFUSED)

    writes: list[str] = []
    try:
        board = _apply_additive(board, fields, plans, writes)
        if mode == "migrate":
            board = _migrate(board, fields, plans, migration, writes)
    except gh.GhError as error:
        landed = (f"\nWrites that had already landed: {'; '.join(writes)}"
                  if writes else "")
        raise gh.GhError(f"{error}{landed}", error.exit_code)
    return {"board": board, **report, "writes": writes, "changed": bool(writes)}


def _plans(board: dict, fields: tuple) -> list:
    return [field_plan for field_plan in
            (board_schema.plan_field(spec, board["fields"].get(spec.name))
             for spec in fields)
            if field_plan is not None]


def _check_moves(moves: dict, plans: list, fields: tuple) -> None:
    """A --move must name an option the plan removes and a declared target."""
    by_field = {field_plan.field: field_plan for field_plan in plans}
    declared = {spec.name: [option.name for option in spec.options or ()]
                for spec in fields}
    for (field_name, option), target in moves.items():
        if declared[field_name] == []:
            continue  # options unknown: nothing is removed, so nothing to judge
        field_plan = by_field.get(field_name)
        if field_plan is None or option not in field_plan.remove:
            removed = ", ".join(field_plan.remove) if field_plan else "none"
            plan.usage_die(
                f"--move names {field_name} {option!r}, which this sync would "
                f"not remove. Options it removes from {field_name}: {removed}",
                _USAGE)
        if target not in declared[field_name]:
            plan.usage_die(
                f"--move sends {field_name} {option!r} to {target!r}, which "
                f"the Tracker Schema does not declare. Declared: "
                f"{', '.join(declared[field_name])}",
                _USAGE)


def _migrate_refusal(loaded: repo_schema.RepoSchema) -> str | None:
    try:
        loaded.require_complete(*board_schema.SECTIONS.values())
    except repo_schema.SchemaIncomplete as error:
        return str(error)
    return None


def _states(loaded: repo_schema.RepoSchema) -> tuple:
    return loaded.section(board_schema.SECTIONS[FIELD_STATUS]) or ()


def _migration(board: dict, plans: list, moves: dict, states) -> dict:
    """{field: plan_moves result} for every field with an option to remove.
    The board's items are read only when there is one."""
    removing = [field_plan for field_plan in plans if field_plan.destructive]
    if not removing:
        return {}
    items = boards.fetch_board_items(board["node_id"])
    return {
        field_plan.field: board_schema.plan_moves(
            field_plan, board["fields"][field_plan.field], items,
            {option: target for (name, option), target in moves.items()
             if name == field_plan.field},
            states,
        )
        for field_plan in removing
    }


def _stranded_message(repository: str, number: int, migration: dict) -> str:
    lines = ["migrate refused before any write: these items hold an option "
             "the Tracker Schema does not declare, and no rule says where "
             "they move:"]
    for field_name, entries in migration.items():
        for entry in entries:
            stranded = [item for item in entry["items"] if item["to"] is None]
            if not stranded:
                continue
            lines.append(f"  {field_name} {entry['option']!r}:")
            for item in stranded:
                lines.append(f"    {_describe(item)}")
    lines.append(
        f"Name where each option's items go with --move <field> <option> "
        f"<to>, previewing with `ghw-board-sync {repository} plan {number} "
        f"--move ...`, or move the items by hand first."
    )
    return "\n".join(lines)


def _describe(item: dict) -> str:
    if item.get("url"):
        state = (item.get("state") or "").lower()
        return f"{item['url']} ({state}) {item.get('title') or ''}".rstrip()
    kind = item.get("type") or "an item the token cannot see"
    return f"{kind} {item['item_id']} {item.get('title') or ''}".rstrip()


def _apply_additive(board: dict, fields: tuple, plans: list,
                    writes: list) -> dict:
    """Create missing fields and make every additive option change, then
    return the board as re-read. Removes nothing."""
    for spec in board_schema.fields_to_create(board, fields, new_board=False):
        _create_field(board, spec)
        writes.append(f"created field {spec.name}")
    changed = [field_plan for field_plan in plans if field_plan.additive]
    for field_plan in changed:
        boards.update_single_select_options(field_plan.field_id,
                                            field_plan.additive)
        writes.append(f"updated {field_plan.field} options "
                      f"(added {len(field_plan.add)}, kept every live option)")
    if not writes:
        return board
    fresh = boards.fetch_board_by_node_id(board["node_id"])
    for field_plan in changed:
        _verify_kept(fresh, field_plan.field, field_plan.additive)
    return fresh


def _migrate(board: dict, fields: tuple, planned: list, migration: dict,
             writes: list) -> dict:
    """Move the items, re-read, then remove the options no item holds."""
    for field_name, entries in migration.items():
        field = board["fields"][field_name]
        for entry in entries:
            for item in entry["items"]:
                target = field["options"].get(item["to"])
                if target is None:
                    raise gh.GhError(
                        f"field {field_name!r} has no option {item['to']!r} "
                        "to move items to, though the additive write should "
                        "have added it; nothing was removed.",
                        plan.EXIT_RUNTIME,
                    )
                boards.set_single_select_value(
                    board["node_id"], item["item_id"], field["id"], target)
                writes.append(f"moved {_describe(item)} from {field_name} "
                              f"{entry['option']!r} to {item['to']!r}")

    board = boards.fetch_board_by_node_id(board["node_id"])
    plans = _plans(board, fields)
    removing = [field_plan for field_plan in plans if field_plan.destructive]
    if not removing:
        return board
    expected = {field_plan.field: set(field_plan.remove) for field_plan in planned}
    for field_plan in removing:
        surprise = set(field_plan.remove) - expected.get(field_plan.field, set())
        if surprise:
            gh.die(
                f"migrate stopped before removing anything: field "
                f"{field_plan.field!r} gained options since the plan "
                f"({', '.join(sorted(surprise))}). Items moved so far keep "
                "their new values; run migrate again to plan afresh.\n"
                f"Writes that had already landed: {'; '.join(writes)}",
                plan.EXIT_REFUSED,
            )
    items = boards.fetch_board_items(board["node_id"])
    for field_plan in removing:
        live = board["fields"][field_plan.field]
        doomed = {live["options"][name] for name in field_plan.remove}
        holding = [item for item in items
                   if item["values"].get(field_plan.field_id) in doomed]
        if holding:
            gh.die(
                f"migrate stopped before removing anything: {len(holding)} "
                f"item(s) hold an option of {field_plan.field!r} to be "
                "removed, though every planned move landed; something set "
                "them since. Run migrate again to move them.\n"
                f"Writes that had already landed: {'; '.join(writes)}",
                plan.EXIT_REFUSED,
            )
    for field_plan in removing:
        boards.update_single_select_options(field_plan.field_id, field_plan.final)
        writes.append(f"removed {field_plan.field} options "
                      f"{', '.join(field_plan.remove)}")
    fresh = boards.fetch_board_by_node_id(board["node_id"])
    for field_plan in removing:
        _verify_kept(fresh, field_plan.field, field_plan.final)
    return fresh


def _verify_kept(board: dict, field_name: str, sent: list) -> None:
    """Fail loudly unless every live option the write kept by id is still
    on the field: GitHub's reference says an id keeps an option's identity,
    and this is where that is checked rather than trusted."""
    live = set((board["fields"].get(field_name) or {}).get("options", {}).values())
    lost = [option["name"] for option in sent
            if option.get("id") and option["id"] not in live]
    if lost:
        raise gh.GhError(
            f"GitHub did not keep options of {field_name!r} that the write "
            f"kept by id: {', '.join(lost)}. Items that held them may have "
            "lost their values; check the board by hand before running "
            "anything else.",
            plan.EXIT_RUNTIME,
        )


def _create_field(board: dict, spec) -> None:
    options = (board_schema.creation_options(spec)
               if spec.data_type == SINGLE_SELECT else None)
    boards.create_field(board["node_id"], spec.name, spec.data_type, options)


def _create_board(repository: str, loaded: repo_schema.RepoSchema,
                  fields: tuple) -> dict:
    """Create a board, link it to the repo, and provision every field."""
    unknown = [spec for spec in fields
               if spec.section is not None and spec.options is None]
    if unknown:
        gh.die(
            "new refused before creating anything: "
            + "; ".join(f"the {spec.name} options come from the Tracker "
                        f"Schema's {spec.section}, which cannot be read"
                        for spec in unknown)
            + f" ({loaded.source}). Fix TRACKER.md on the default branch "
            "and run new again.",
            loaded.refusal_exit_code(),
        )
    existing = boards.fetch_boards(repository)
    if existing:
        candidates = ", ".join(
            f"#{entry['number']} ({entry['title']})" for entry in existing
        )
        gh.die(
            f"{repository} already has linked open board(s): {candidates}. "
            "Pass a mode and a project number instead of 'new' to sync one "
            "of them; creating a second board is a deliberate act for a "
            "human.",
            plan.EXIT_REFUSED,
        )
    identity = boards.fetch_repository_identity(repository)
    try:
        project = boards.create_project(identity["owner_node_id"],
                                        repository.split("/", 1)[1])
    except gh.GhError as error:
        # createProjectV2 is not idempotent: a timeout or reset may have
        # created an unlinked board, and a re-run would create a second one.
        raise gh.GhError(str(error), gh.write_exit_code(error))
    # From here the board exists but is not yet linked, so fetch_boards (which
    # only sees linked boards) cannot find it again. Every later failure has to
    # name it, or a re-run creates a second orphan nobody knows about.
    writes: list[str] = []
    try:
        boards.link_project_to_repository(project["node_id"], identity["node_id"])
        board = boards.fetch_board_by_node_id(project["node_id"])
        status = board["fields"].get(FIELD_STATUS)
        spec = next(spec for spec in fields if spec.name == FIELD_STATUS)
        if status is not None and status["data_type"] == SINGLE_SELECT:
            # The stock Todo/In progress/Done options, on a board that
            # cannot yet have items, so none is moved first.
            boards.update_single_select_options(
                status["id"], board_schema.creation_options(spec))
            writes.append(f"replaced the stock {FIELD_STATUS} options")
        for missing in board_schema.fields_to_create(board, fields,
                                                     new_board=True):
            _create_field(board, missing)
            writes.append(f"created field {missing.name}")
        fresh = boards.fetch_board_by_node_id(project["node_id"])
    except gh.GhError as error:
        landed = f"; done: {'; '.join(writes)}" if writes else ""
        raise gh.GhError(
            f"{error}\nProject #{project['number']} WAS created "
            f"({project['url']}) and is half-provisioned{landed}. Do not re-run "
            f"with 'new' -- finish it with `ghw-board-sync {repository} apply "
            f"{project['number']}`, or delete the project by hand.",
            # Never the error's own code: 6 invites a retry of 'new' (a second
            # orphan project) and 3 reads as an answer, yet the board is
            # half-provisioned. 1 means stop and report.
            plan.EXIT_RUNTIME,
        )
    return {
        "board": fresh,
        "created_board": True,
        "writes": writes,
        "changed": True,
    }


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
