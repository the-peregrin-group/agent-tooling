#!/usr/bin/python3
"""ghw-issue-create <repo> <kind-label> <title> <body-file> [label ...] -- file a new issue.

Validates the label attachment contract against the repo's Tracker Schema,
read from TRACKER.md on its default branch, before writing: <kind-label> is
one of the schema's Issue Kinds and no second kind is among the labels,
every label is one the schema declares, every axis the schema marks as
carried by every Issue has a label among them, and every label already
exists in the repo's live label registry (ghw-label-sync is the sole
label-creation path). Every problem in TRACKER.md is printed as a warning
on stderr. Filing is an additive write: a rule whose part of the schema is
missing or unusable is skipped with a warning, and the Verb goes ahead on
what can still be checked, at least that every label exists.

The label tail takes no flags: a label beginning with '-' is a usage error,
refused before any network call. The body comes from a staged file under
/tmp/claude/ or ~/.claude/jobs/<job-id>/tmp/ (never inline text).
Deliberately non-idempotent: search for duplicates before filing, per
skill-text guidance.

Exit codes: 0 success, 1 unclassified gh/API failure, 2 usage error, 3 not
found, 4 refused: the label set violates the attachment contract (a kind
the schema does not declare, a second or repeated kind, an undeclared
label, no label from a required axis, a label missing from the registry),
5 auth failure, 6 network failure (retryable). A failure whose request may
already have landed (a timeout or reset) exits 1 instead of 6 on the
non-idempotent write Verbs, so a retry cannot duplicate it.
"""

from __future__ import annotations

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

from lib import arguments, plan, staging
from lib.github import boards, gh, labels, repo_schema

_USAGE = "ghw-issue-create <owner/repo> <kind-label> <title> <body-file> [label ...]"


def main(argv: list[str]) -> int:
    """Entry point; the module docstring above is the CLI contract. Returns
    the process exit code."""
    if argv and argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return plan.EXIT_OK
    if len(argv) < 4:
        plan.usage_die("expected at least four arguments", _USAGE)
    repository, kind_label, title, body_path = argv[:4]
    extra_labels = list(argv[4:])
    if not arguments.is_valid_repository(repository):
        plan.usage_die(f"repo must be 'owner/name', got {repository!r}", _USAGE)
    if not kind_label.strip():
        plan.usage_die("kind label must not be empty", _USAGE)
    if not title.strip():
        plan.usage_die("title must not be empty", _USAGE)
    for label in extra_labels:
        if arguments.is_flag_shaped(label):
            plan.usage_die(
                f"ghw-issue-create takes no flags, got {label!r}", _USAGE
            )
    body = staging.read_staged_body(body_path)

    rules = labels.LabelRules(repo_schema.load(repository))
    for line in rules.unchecked():
        print(line, file=sys.stderr)
    try:
        registry = {label["name"] for label in boards.fetch_labels(repository)}
    except gh.GhError as error:
        gh.die(str(error), error.exit_code)

    try:
        labels.validate_creation_labels(kind_label, extra_labels, registry, rules)
    except labels.LabelContractError as error:
        gh.die(str(error), plan.EXIT_REFUSED)

    all_labels = [kind_label, *extra_labels]
    try:
        url = gh.issue_create(repository, title, body, all_labels)
    except gh.GhError as error:
        gh.die(str(error), gh.write_exit_code(error))

    plan.emit_plan(
        "applied",
        repository=repository,
        issue=_issue_number_from_url(url),
        url=url,
        title=title,
        labels=all_labels,
    )
    return plan.EXIT_OK


def _issue_number_from_url(url: str) -> int | None:
    """Best-effort issue number from gh's created-issue URL; None when the URL
    shape is unexpected (the URL itself is still reported either way)."""
    tail = url.rstrip("/").rsplit("/", 1)[-1]
    return int(tail) if tail.isdigit() else None


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
